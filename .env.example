# --- Database MySQL / MariaDB ---
# Lokal (XAMPP/Laragon): host 127.0.0.1, user root, password kosong, buat database lewat phpMyAdmin.
# Hostinger: isi sesuai yang tampil di hPanel > Databases (nama db & user biasanya berawalan u123456789_).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=huda_portfolio
DB_USER=root
DB_PASSWORD=

# --- Admin ---
ADMIN_USERNAME=admin
# Pilih salah satu: ADMIN_PASSWORD_HASH (disarankan, buat dengan `npm run hash-password`) atau ADMIN_PASSWORD (teks biasa)
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Kunci rahasia sesi login (min 32 karakter). Buat: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# --- Upload gambar ---
# Tempat menyimpan foto: kosongkan/disk = folder UPLOAD_DIR, atau "db" = di database MySQL.
# Di Hostinger Node.js Web Apps pakai "db" (paling aman: isi folder aplikasi ditimpa tiap deploy).
STORAGE_DRIVER=disk
# Untuk mode disk: gunakan folder DI LUAR folder aplikasi supaya tidak terhapus saat deploy ulang (lihat docs/PANDUAN-HOSTINGER.md).
UPLOAD_DIR=./uploads
# Hanya jika memakai Vercel Blob (tidak perlu di Hostinger)
BLOB_READ_WRITE_TOKEN=

# --- Umum ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
